Memoria/Fuente LaTeX/*.out
Memoria/Fuente LaTeX/*.run.xml
Memoria/Fuente LaTeX/*.synctex.gz
Memoria/Fuente LaTeX/*.toc

# ─── Archivos temporales del sistema ─────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ─── Documentos institucionales (no redistribuibles) ─────────────────────────
