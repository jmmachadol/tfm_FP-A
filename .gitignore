# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# ─── Entornos virtuales ───────────────────────────────────────────────────────
env/
venv/
.venv/
.env

# ─── Jupyter ─────────────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ─── Dataset (se descarga automáticamente con data_loader.py) ─────────────────
data/raw/
data/interim/
data/processed/

# ─── LaTeX — archivos auxiliares de compilación ──────────────────────────────
Memoria/Fuente LaTeX/*.aux
Memoria/Fuente LaTeX/*.bbl
Memoria/Fuente LaTeX/*.bcf
Memoria/Fuente LaTeX/*.blg
Memoria/Fuente LaTeX/*.fdb_latexmk
Memoria/Fuente LaTeX/*.fls
Memoria/Fuente LaTeX/*.lof
