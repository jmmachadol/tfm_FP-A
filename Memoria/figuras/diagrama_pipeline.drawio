<mxfile host="app.diagrams.net" modified="2025-06-01" agent="5.0" version="21.0.0" type="device">
  <diagram name="Pipeline TFM FP&amp;A" id="pipeline-tfm">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TÍTULO -->
        <mxCell id="title" value="Pipeline de Pronóstico para FP&amp;A — Arquitectura Modular" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#003366;" vertex="1" parent="1">
          <mxGeometry x="127" y="20" width="1400" height="40" as="geometry" />
        </mxCell>

        <!-- ══════════════════════════════════════════════════ -->
        <!-- COLUMNA 1: DATOS -->
        <!-- ══════════════════════════════════════════════════ -->
        <mxCell id="col1_label" value="DATOS" style="text;html=1;strokeColor=none;fillColor=#dae8fc;align=center;verticalAlign=middle;fontStyle=1;fontSize=12;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="127" y="80" width="200" height="35" as="geometry" />
        </mxCell>

        <!-- M4 Competition Dataset -->
        <mxCell id="m4_source" value="M4 Competition Dataset&#xa;(Repositorio GitHub oficial)&#xa;10.987 series Finance-Monthly" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="127" y="135" width="200" height="80" as="geometry" />
        </mxCell>

        <!-- data_loader.py -->
        <mxCell id="data_loader" value="data_loader.py&#xa;load_m4_finance()&#xa;• Descarga/caché M4-info.csv&#xa;• Descarga/caché Monthly-train.csv&#xa;• Filtra Finance-Monthly" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;" vertex="1" parent="1">
          <mxGeometry x="127" y="250" width="200" height="85" as="geometry" />
        </mxCell>

        <!-- preprocessor.py -->
        <mxCell id="preprocessor" value="preprocessor.py&#xa;• filter_by_min_length(≥72m)&#xa;• stratified_subsample(N=200)&#xa;  estratificado por cuartil&#xa;• extract_series_list()&#xa;• get_volume_deciles()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;" vertex="1" parent="1">
          <mxGeometry x="127" y="365" width="200" height="100" as="geometry" />
        </mxCell>

        <!-- Series list output -->
        <mxCell id="series_list" value="Lista de arrays numpy&#xa;200 series × longitud variable&#xa;Deciles de volumen asignados" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="127" y="490" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- ══════════════════════════════════════════════════ -->
        <!-- COLUMNA 2: BACKTESTING -->
        <!-- ══════════════════════════════════════════════════ -->
        <mxCell id="col2_label" value="VALIDACIÓN TEMPORAL" style="text;html=1;strokeColor=none;fillColor=#d5e8d4;align=center;verticalAlign=middle;fontStyle=1;fontSize=12;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="80" width="230" height="35" as="geometry" />
        </mxCell>

        <!-- config.py -->
        <mxCell id="config" value="config.py — ExperimentConfig&#xa;• seasonality = 12&#xa;• horizon = 18 meses&#xa;• initial_train = 54 meses&#xa;• step = 12 meses&#xa;• window = expanding&#xa;• SEED = 42" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=9;align=left;" vertex="1" parent="1">
          <mxGeometry x="360" y="135" width="230" height="110" as="geometry" />
        </mxCell>

        <!-- backtesting.py -->
        <mxCell id="backtesting" value="backtesting.py&#xa;generate_folds(n, config)&#xa;━━━━━━━━━━━━━━━━━━━&#xa;Por cada serie:&#xa;  train_end = initial_train&#xa;  while train_end+horizon ≤ n:&#xa;    Fold(train[0:train_end],&#xa;         test[train_end:+horizon])&#xa;    train_end += step&#xa;  ← últimos max_folds=5 folds&#xa;━━━━━━━━━━━━━━━━━━━&#xa;verify_no_leakage()&#xa;• Verifica disyunción índices&#xa;• Verifica contigüidad&#xa;• Verifica avance temporal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;align=left;" vertex="1" parent="1">
          <mxGeometry x="360" y="270" width="230" height="195" as="geometry" />
        </mxCell>

        <!-- Folds output -->
        <mxCell id="folds_out" value="List[Fold]&#xa;Fold(train_slice, test_slice)&#xa;≤5 folds por serie" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="360" y="490" width="230" height="60" as="geometry" />
        </mxCell>

        <!-- ══════════════════════════════════════════════════ -->
        <!-- COLUMNA 3: MODELOS -->
        <!-- ══════════════════════════════════════════════════ -->
        <mxCell id="col3_label" value="MODELOS DE PRONÓSTICO" style="text;html=1;strokeColor=none;fillColor=#e1d5e7;align=center;verticalAlign=middle;fontStyle=1;fontSize=12;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="625" y="80" width="530" height="35" as="geometry" />
        </mxCell>

        <!-- BaseForecaster -->
        <mxCell id="base" value="models/base.py&#xa;BaseForecaster (local)&#xa;+ fit(train) → self&#xa;+ predict(horizon) → array&#xa;━━━━━━━━━━━━━&#xa;GlobalBaseForecaster&#xa;+ fit_global(List[array])&#xa;+ predict(history, horizon)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;align=left;" vertex="1" parent="1">
          <mxGeometry x="625" y="135" width="220" height="140" as="geometry" />
        </mxCell>

        <!-- MODELOS LOCALES -->
        <mxCell id="local_label" value="MODELOS LOCALES (ajuste por serie)" style="text;html=1;strokeColor=#82b366;fillColor=#d5e8d4;align=center;fontSize=10;fontStyle=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="625" y="295" width="220" height="25" as="geometry" />
        </mxCell>

        <mxCell id="snaive" value="baseline.py — SeasonalNaive&#xa;Repite último patrón de 12m" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="625" y="330" width="220" height="40" as="geometry" />
        </mxCell>

        <mxCell id="ets" value="statistical.py — ETSForecaster&#xa;statsforecast.AutoETS&#xa;Selección automática por AICc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="625" y="380" width="220" height="45" as="geometry" />
        </mxCell>

        <mxCell id="hw" value="statistical.py — HoltWintersForecaster&#xa;statsmodels.ExponentialSmoothing&#xa;Aditivo/multiplicativo (auto)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="625" y="435" width="220" height="45" as="geometry" />
        </mxCell>

        <mxCell id="sarima" value="statistical.py — SARIMAForecaster&#xa;statsforecast.AutoARIMA&#xa;Hyndman-Khandakar, approx=True" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="625" y="490" width="220" height="45" as="geometry" />
        </mxCell>

        <!-- MODELOS GLOBALES -->
        <mxCell id="global_label" value="MODELOS GLOBALES (fit en todas las series)" style="text;html=1;strokeColor=#d6b656;fillColor=#fff2cc;align=center;fontSize=10;fontStyle=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="865" y="295" width="270" height="25" as="geometry" />
        </mxCell>

        <mxCell id="lgbm" value="ml.py — LightGBMForecaster&#xa;• 36 lags como features&#xa;• Global training (todas las series)&#xa;• Predicción recursiva&#xa;• Escalado MaxAbs por serie" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;" vertex="1" parent="1">
          <mxGeometry x="865" y="330" width="270" height="70" as="geometry" />
        </mxCell>

        <mxCell id="mlp" value="ml.py — MLPForecaster (Bottleneck)&#xa;• 36 lags → 18 predicciones directas&#xa;• BatchNorm + Dropout + AdamW&#xa;• Direct forecasting (sin recursión)&#xa;• Entrenado en PyTorch CPU" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;" vertex="1" parent="1">
          <mxGeometry x="865" y="410" width="270" height="70" as="geometry" />
        </mxCell>

        <mxCell id="nbeats" value="ml.py — NBEATSForecaster (Interpretable)&#xa;• Stack Tendencia: bases polinomiales&#xa;• Stack Estacionalidad: bases Fourier&#xa;• Conexiones residuales (backcast)&#xa;• Direct forecasting en PyTorch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;" vertex="1" parent="1">
          <mxGeometry x="865" y="490" width="270" height="70" as="geometry" />
        </mxCell>

        <!-- ══════════════════════════════════════════════════ -->
        <!-- COLUMNA 4: EVALUACIÓN -->
        <!-- ══════════════════════════════════════════════════ -->
        <mxCell id="col4_label" value="EVALUACIÓN" style="text;html=1;strokeColor=none;fillColor=#ffe6cc;align=center;verticalAlign=middle;fontStyle=1;fontSize=12;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="1185" y="80" width="210" height="35" as="geometry" />
        </mxCell>

        <!-- evaluation.py -->
        <mxCell id="evaluation" value="evaluation.py — compute_all()&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;MÉTRICAS ESTADÍSTICAS:&#xa;• MAE = mean(|y−ŷ|)&#xa;• RMSE = √mean((y−ŷ)²)&#xa;• MAPE = mean(|y−ŷ|/|y|)×100&#xa;• sMAPE = mean(|y−ŷ|/((|y|+|ŷ|)/2))×100&#xa;  [estándar M4]&#xa;• MASE = MAE / escala_naive_estacional&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;MÉTRICAS ECONÓMICAS:&#xa;• WAPE = Σ|y−ŷ|/Σ|y|×100&#xa;• Contribución al error por decil" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=9;align=left;" vertex="1" parent="1">
          <mxGeometry x="1185" y="135" width="210" height="230" as="geometry" />
        </mxCell>

        <!-- visualization.py -->
        <mxCell id="visualization" value="visualization.py&#xa;• Fig.1: Esquema walk-forward&#xa;• Fig.2: Barras sMAPE (comparativa)&#xa;• Fig.3: Heatmap métricas&#xa;• Fig.4: Estabilidad temporal&#xa;• Fig.5: Contribución deciles" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=9;align=left;" vertex="1" parent="1">
          <mxGeometry x="1185" y="385" width="210" height="110" as="geometry" />
        </mxCell>

        <!-- Resultados -->
        <mxCell id="results_csv" value="results/tables/&#xa;resultados_comparativa.csv&#xa;resultados_detalle.csv&#xa;(modelo×métrica: media±std)" style="shape=mxgraph.flowchart.stored_data;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="1185" y="515" width="210" height="70" as="geometry" />
        </mxCell>

        <!-- ══════════════════════════════════════════════════ -->
        <!-- ORQUESTADOR -->
        <!-- ══════════════════════════════════════════════════ -->
        <mxCell id="orchestrator" value="notebooks/main.ipynb — ORQUESTADOR&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;for cada fold:&#xa;  LOCAL: model.fit(train) → model.predict(18)          ← por serie&#xa;  GLOBAL: model.fit_global(all_trains) → model.predict(train, 18)  ← por fold&#xa;  metrics = compute_all(test, pred, train)&#xa;  records.append({model, series_idx, fold_id, decile, **metrics})" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#003366;strokeColor=#001a33;fontSize=10;fontColor=#ffffff;align=left;" vertex="1" parent="1">
          <mxGeometry x="127" y="620" width="1268" height="80" as="geometry" />
        </mxCell>

        <!-- ══════════════════════════════════════════════════ -->
        <!-- MEMORIA LaTeX -->
        <!-- ══════════════════════════════════════════════════ -->
        <mxCell id="latex_doc" value="memoria/main.tex — ENTREGABLE ACADÉMICO&#xa;Cap. 4 Planteamiento → Cap. 5 Resultados → Cap. 6 Discusión → Cap. 7 Conclusiones&#xa;update_results_latex.py lee los CSV y actualiza los capítulos automáticamente" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#003366;strokeColor=#001a33;fontSize=10;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="127" y="730" width="1268" height="60" as="geometry" />
        </mxCell>

