        <!-- NOTA METODOLÓGICA -->
        <mxCell id="nota" value="NOTA: Los modelos locales (SNaive, ETS, HW, SARIMA) realizan ajuste e inferencia independiente por serie y fold. Los modelos globales (LightGBM, MLP, N-BEATS) entrenan un único modelo por fold sobre todas las series simultáneamente (global forecasting). Ambos paradigmas se comparan bajo el mismo protocolo walk-forward y las mismas métricas de evaluación." style="text;html=1;strokeColor=#003366;fillColor=#dae8fc;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="127" y="820" width="1268" height="50" as="geometry" />
